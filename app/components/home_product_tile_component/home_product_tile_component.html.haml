%article.home-product
  %a.home-product-link{ href: shop_path }
    - if product.image
      = image_tag(product.image.url(:small), alt: product.image.alt, title: product.image.alt)
    - else
      = image_tag(Spree::Image.default_image_url(:small), class: "placeholder", alt: "")
    %p.producer
      = producer_name
      - if origin
        %span.origin= origin
    %p.product-name= product_name
    %p.prices
      - unless product.single_variant?
        = t("components.home_product_tile.from_price")
      %span.price= price
      - if unit_price
        %span.unit-price= unit_price
    %p.shop= sold_at
    %p.closes-in= closes_in
    - if (progress = pallet_progress)
      = render PalletProgressComponent.new(progress:, compact: true)
