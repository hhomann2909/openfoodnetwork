= turbo_frame_tag "shop-products" do
  .loading{ style: "display: none;", "data-product-grid-view-target": "loading" }
    = render partial: "shop/products/product_spinner"

  - if @pallets.any?
    .pallet-progress-list
      - if @pallets.many?
        %p.pallet-progress-list-intro= t("components.pallet_progress.list_intro")
      - @pallets.each do |pallet|
        = render PalletProgressComponent.new(progress: pallet, explain: @pallets.one?)

  .products-container{ "data-product-grid-view-target": "products" }
    - @products.each do |product|
      = render ProductTileComponent.new(product:, variants_in_cart: @variants_in_cart, low_stock_display: @low_stock_display)
