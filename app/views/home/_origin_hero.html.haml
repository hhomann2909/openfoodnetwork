-# Hero for the south-north marketplace (feature: home_products): what it is, in figures taken
-# from what is on sale right now, with the products themselves as the picture.
= cache_with_locale ["home-origin-hero", home_product_origin], expires_in: 5.minutes do
  - stats = home_product_stats
  - images = home_product_offers.filter_map { |offer| offer.product.image }.first(4)
  - countries = home_product_origins.map { |country| country_display_name(country) }
  #origin-hero
    .row
      .small-12.large-6.columns.origin-hero-text
        - if countries.any?
          %p.origin-hero-kicker= t("origin_hero.kicker", countries: countries.to_sentence(two_words_connector: t("origin_hero.and"), last_word_connector: t("origin_hero.and")))
        %h1= t("origin_hero.title")
        %p.origin-hero-lead= t("origin_hero.lead")
        .origin-hero-actions
          %a.origin-hero-cta{ href: "#home-products" }= t("origin_hero.cta")
          = link_to t("origin_hero.map"), main_app.map_path, class: "origin-hero-link"
        %ul.origin-hero-facts
          - if stats.item_cost_share
            %li
              %strong= number_to_percentage(stats.item_cost_share * 100, precision: 0)
              %span= t("origin_hero.fact_share")
          - if stats.producer_count.positive?
            %li
              %strong= stats.producer_count
              %span= t("origin_hero.fact_producers", count: stats.producer_count)
          - if stats.closes_at
            %li
              %strong= distance_of_time_in_words_to_now(stats.closes_at)
              %span= t("origin_hero.fact_closes")
      - if images.size >= 2
        .small-12.large-6.columns
          .origin-hero-collage{ class: "has-#{images.size}", "aria-hidden": "true" }
            - images.each do |image|
              = image_tag image.url(:large), alt: "", loading: "eager"
